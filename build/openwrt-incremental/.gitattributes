# Scripts run inside the Linux build container — force LF regardless of host.
*.sh   text eol=lf
*.init text eol=lf
build.sh text eol=lf
scripts/*.sh text eol=lf
spid-start text eol=lf
usbexecd-start text eol=lf
*.dts  text eol=lf
config.seed text eol=lf
# node-8 tessel runtime JS is consumed inside the Linux build container.
scripts/tessel-node8-js/*.js text eol=lf
