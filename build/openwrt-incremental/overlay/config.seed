# Minimal .config seed for the Tessel bridge-validation image.
# `make defconfig` expands this to a full config.
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
# Device profile symbol differs by release:
#   17.01/18.06:  CONFIG_TARGET_ramips_mt7620_DEVICE_tessel
#   19.07+:       CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_tessel
# List both; make defconfig silently drops whichever does not apply.
CONFIG_TARGET_ramips_mt7620_DEVICE_tessel=y
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_tessel=y

# Coprocessor bridge + spidev.
CONFIG_PACKAGE_tessel-tools=y
CONFIG_PACKAGE_kmod-spi-dev=y

# USB host (module ports / peripherals).
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y

# WiFi station mode (`t2 wifi`) and LAN discovery (`t2 list`).
#
#   wpad-basic-mbedtls  full wpa_supplicant, i.e. WPA2-PSK *client* (station) mode.
#                       Replaces CONFIG_PACKAGE_wpad-mini, which no longer exists at
#                       25.12 -- that line was silently dropped by `make defconfig`
#                       and the target default happened to supply this same package.
#                       Naming it explicitly pins the behaviour.
#   rpcd-mod-iwinfo     provides `ubus call iwinfo info '{"device":"wlan0"}'`, which
#                       t2-cli uses to read WiFi status (lib/tessel/commands.js).
#                       Without it the image has no /usr/libexec/rpcd at all and the
#                       call fails with "Not found".
#   rpcd                MUST be named explicitly. rpcd-mod-iwinfo declares `rpcd` as a
#                       hard dependency (no `+` prefix in its Depends line), so it is
#                       NOT auto-selected; on an image this minimal nothing else pulls
#                       rpcd in, and `make defconfig` then silently invalidates
#                       rpcd-mod-iwinfo=y. Dropping this line drops iwinfo entirely.
#   umdns               mDNS responder. `t2 list` browses _tessel._tcp
#                       (lib/lan-connection.js) -- with no responder in the image the
#                       board can never be discovered over the network.
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_umdns=y
