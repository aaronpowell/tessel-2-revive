#!/bin/sh
# spid-start — launch the SPI bridge daemon.
#
# The Tessel coprocessor is the ONLY spidev on the bus (the SPI-NOR flash uses
# the m25p80/spi-nor driver, which does not create a /dev/spidev node). On the
# upstream two-controller model it enumerates as /dev/spidev1.0 (spi@b40, bus 1,
# CS0); on other kernels the bus number may differ. So just pick the first
# /dev/spidev* node that exists rather than hard-coding bus/CS numbers.
mkdir -p /var/run/tessel
ln -sf /var/run/tessel/1 /var/run/tessel/port_a
ln -sf /var/run/tessel/2 /var/run/tessel/port_b

SPIDEV="$(ls /dev/spidev* 2>/dev/null | head -n1)"
[ -z "$SPIDEV" ] && SPIDEV=/dev/spidev1.0

# IRQ GPIO = 2, SYNC GPIO = 1 (global sysfs numbers; valid while gpiochip base is 0).
exec spid "$SPIDEV" 2 1 /var/run/tessel
